# Read by docker-compose.yml and passed into the containers it starts.
# Copy this file to .env and fill in real values; .env is gitignored.

# --- Dashboard login (required) -------------------------------------------
# Credentials for the single operator account that signs into the
# dashboard. AUTH_USERNAME/AUTH_PASSWORD are checked on login;
# JWT_SECRET signs the session cookie issued afterwards. All three have
# insecure defaults baked into docker-compose.yml so the stack still
# boots without a .env, but you should set real values before exposing
# this anywhere but localhost.
AUTH_USERNAME=admin
AUTH_PASSWORD=password
JWT_SECRET=change-me-to-a-long-random-string

# --- Public deployment URLs (required when not on localhost) ---------------
# API_URL is the browser-facing api URL for this frontend instance. It is
# read at container start and served to the app from /runtime-config, so
# the same built frontend image can be reused across instances pointing
# at different api backends — no rebuild needed. It must be the api's
# publicly reachable URL (not "localhost", which resolves to the
# visitor's own machine) — e.g. https://api.yourdomain.com.
# CORS_ORIGIN must match the origin(s) the frontend is served from, or
# the api will reject its requests. Accepts a comma-separated list when
# one api serves several dashboard instances.
# API_URL=https://api.yourdomain.com
# CORS_ORIGIN=https://yourdomain.com

# --- Market-data retention (optional, engine) -------------------------------
# Sampled price data older than this many days is pruned. Defaults to 7.
# MARKET_DATA_TTL_DAYS=7

# --- Sampling frequency floor (optional, api) -------------------------------
# Minimum sampling frequency, in seconds, that this deployment accepts.
# Sampling configs below it are rejected. Defaults to 1.
# MIN_SAMPLING_FREQUENCY_SECONDS=30

# --- Demo mode (optional) ---------------------------------------------------
# Set DEMO_MODE=true to hard-disable live trading on this
# deployment: switching the engine to live is rejected and live wallet
# creation is disabled. The dashboard shows a "Paper trading only"
# warning instead of the live-trading toggle. Requires redeploying to undo.
# DEMO_MODE=true

# --- TypeSafe Jev decision maker (optional) --------------------------------
# Only needed if you enable a PERP's decision maker as "typesafe" from the
# dashboard. Without TYPESAFE_API_KEY, the engine still starts — that
# decision maker just rejects every call until configured. Leave both
# commented out to stick with the Fake decision maker (synthetic
# decisions, no external calls).
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# --- OpenRouter Jev decision maker (optional) --------------------------------
# Reaches the same Jev model through OpenRouter instead of TypeSafe directly,
# if you enable a PERP's decision maker as "openrouter" from the dashboard.
# Without OPENROUTER_API_KEY, the engine still starts — that decision maker
# just rejects every call until configured.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Live Hyperliquid execution (optional) ---------------------------------
# Only needed if you switch a PERP's execution mode to "live" from the
# dashboard. Without HYPERLIQUID_PRIVATE_KEY, the engine still starts —
# live mode just rejects every call until configured. Leave commented out
# to stick with mock execution (simulated fills, no real orders).
# HYPERLIQUID_PRIVATE_KEY=0x...
# HYPERLIQUID_TESTNET=true
